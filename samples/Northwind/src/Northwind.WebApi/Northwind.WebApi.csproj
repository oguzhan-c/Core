<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>northwind-can-starter</UserSecretsId>
    <ClientAppRoot>ClientApp\</ClientAppRoot>
  </PropertyGroup>

  <!-- React uygulaması (ClientApp) .NET derlemesine girmez; yayında derlenip wwwroot'a konur. -->
  <ItemGroup>
    <Compile Remove="$(ClientAppRoot)**" />
    <Content Remove="$(ClientAppRoot)**" />
    <None Remove="$(ClientAppRoot)**" />
    <None Include="$(ClientAppRoot)**" Exclude="$(ClientAppRoot)node_modules\**;$(ClientAppRoot)dist\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Northwind.Infrastructure\Northwind.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\..\src\Can.Core.WebApi\Can.Core.WebApi.csproj" />
    <ProjectReference Include="..\..\..\..\src\Can.Core.Reporting.AspNetCore\Can.Core.Reporting.AspNetCore.csproj" />
    <ProjectReference Include="..\..\..\..\src\Can.Core.Logging.Serilog\Can.Core.Logging.Serilog.csproj" />
    <ProjectReference Include="..\..\..\..\src\Can.Core.Mailing.MailKit\Can.Core.Mailing.MailKit.csproj" />
    <ProjectReference Include="..\..\..\..\src\Can.Core.Mailing.SendGrid\Can.Core.Mailing.SendGrid.csproj" />
    <ProjectReference Include="..\..\..\..\src\Can.Core.Caching.Redis\Can.Core.Caching.Redis.csproj" />
    <ProjectReference Include="..\..\..\..\src\Can.Core.Observability.OpenTelemetry\Can.Core.Observability.OpenTelemetry.csproj" />
    <ProjectReference Include="..\..\..\..\src\Can.Core.Realtime.SignalR\Can.Core.Realtime.SignalR.csproj" />
    <ProjectReference Include="..\..\..\..\src\Can.Core.Search.Elasticsearch\Can.Core.Search.Elasticsearch.csproj" />
    <ProjectReference Include="..\..\..\..\src\Can.Core.Redis.ScaleOut\Can.Core.Redis.ScaleOut.csproj" />
    <ProjectReference Include="..\..\..\..\src\Can.Core.BackgroundJobs.Hangfire\Can.Core.BackgroundJobs.Hangfire.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.PostgreSql" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
    <!-- dotnet ef migrations add ... için -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Northwind.WebApi.Tests" />
  </ItemGroup>

  <!-- dotnet publish: React uygulamasını derleyip (vite → wwwroot) yayına ekler. -->
  <Target Name="PublishClientApp" AfterTargets="ComputeFilesToPublish">
    <Exec WorkingDirectory="$(ClientAppRoot)" Command="npm ci" />
    <Exec WorkingDirectory="$(ClientAppRoot)" Command="npm run build" />
    <ItemGroup>
      <ClientDistFiles Include="wwwroot\**" />
      <ResolvedFileToPublish Include="@(ClientDistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(FileName)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
