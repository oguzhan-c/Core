<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Can.Core.Resilience</RootNamespace>
    <Description>Dış paket gerektirmeyen dayanıklılık (resilience) kütüphanesi: retry, circuit breaker, timeout, rate limiter/bulkhead, fallback ve hedging stratejilerinden oluşan pipeline'lar.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- Microsoft'un sınırlayıcıları (ASP.NET Core'da yerleşik; konsol/worker projeleri için paket olarak gelir) -->
    <PackageReference Include="System.Threading.RateLimiting" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Can.Core.Resilience.Tests" />
  </ItemGroup>

</Project>
