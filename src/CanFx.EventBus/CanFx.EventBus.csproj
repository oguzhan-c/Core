<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CanFx.EventBus</RootNamespace>
    <Description>Integration event'leri servisler/örnekler arasında taşıyan event bus soyutlaması: zarf (envelope), sabit event adları, tenant'ı koruyan dağıtıcı ve bellek içi taşıyıcı. RabbitMQ gibi taşıyıcılar ayrı paket olarak eklenir.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CanFx.Domain\CanFx.Domain.csproj" />
    <ProjectReference Include="..\CanFx.Mediator.Abstractions\CanFx.Mediator.Abstractions.csproj" />
    <ProjectReference Include="..\CanFx.MultiTenancy\CanFx.MultiTenancy.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CanFx.EventBus.Tests" />
  </ItemGroup>

</Project>
