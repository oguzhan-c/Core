<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CanFx.Observability.OpenTelemetry</RootNamespace>
    <Description>CanFx paketlerinin ve .NET'in yerleşik telemetrisini (ASP.NET Core, HttpClient, runtime) OpenTelemetry ile OTLP üzerinden dışa aktarır (Grafana, Jaeger, Seq, Aspire Dashboard, Datadog ...).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>

</Project>
