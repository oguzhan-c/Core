{
  "$schema": "http://json.schemastore.org/template",
  "author": "Can",
  "classifications": [
    "Web",
    "API",
    "Clean Architecture",
    "Can.Core"
  ],
  "identity": "Can.Core.Templates.Monolith",
  "groupIdentity": "Can.Core.Templates.Monolith",
  "name": "Can.Core Monolith",
  "description": "Can.Core paketleriyle monolith Web API: Domain / Application (CQRS) / Persistence / WebApi. Kimlik (JWT HttpOnly cookie), 2FA, passkey, çoklu kiracılık ve dış servisler seçmeli.",
  "shortName": "can-monolith",
  "sourceName": "CanAppTemplate",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "symbols": {
    "Database": {
      "type": "parameter",
      "displayName": "Veritabanı",
      "description": "EF Core sağlayıcısı.",
      "datatype": "choice",
      "choices": [
        {
          "choice": "postgresql",
          "displayName": "PostgreSQL",
          "description": "Npgsql (docker compose ile)"
        },
        {
          "choice": "sqlserver",
          "displayName": "SQL Server",
          "description": "Microsoft.EntityFrameworkCore.SqlServer (docker compose ile)"
        },
        {
          "choice": "sqlite",
          "displayName": "SQLite",
          "description": "Dosya veritabanı; kurulum gerekmez"
        }
      ],
      "defaultValue": "postgresql"
    },
    "UsePostgreSql": {
      "type": "computed",
      "value": "(Database == \"postgresql\")"
    },
    "UseSqlServer": {
      "type": "computed",
      "value": "(Database == \"sqlserver\")"
    },
    "UseSqlite": {
      "type": "computed",
      "value": "(Database == \"sqlite\")"
    },
    "MultiTenancy": {
      "type": "parameter",
      "displayName": "Tenancy: Multi-tenancy",
      "description": "Çoklu kiracılık: tenant token'da (cookie), veriler TenantId ile ya da tenant başına veritabanıyla ayrılır.",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "Otp": {
      "type": "parameter",
      "displayName": "Security: OTP (authenticator uygulaması)",
      "description": "TOTP ile iki adımlı doğrulama (Google/Microsoft Authenticator).",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "EmailTwoFactor": {
      "type": "parameter",
      "displayName": "Security: 2FA (e-posta kodu)",
      "description": "Girişte e-postaya gönderilen kod ile iki adımlı doğrulama.",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "TwoFactor": {
      "type": "computed",
      "value": "(Otp || EmailTwoFactor)"
    },
    "Passkey": {
      "type": "parameter",
      "displayName": "Security: Passkey (WebAuthn)",
      "description": "Şifresiz giriş: parmak izi / yüz tanıma / güvenlik anahtarı.",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "ExternalLogin": {
      "type": "parameter",
      "displayName": "Security: Dış hesapla giriş",
      "description": "Google / Microsoft / GitHub ile giriş ve hesap bağlama.",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "Redis": {
      "type": "parameter",
      "displayName": "Altyapı: Redis",
      "description": "Dağıtık önbellek, Data Protection anahtarları, hız sınırı, kilit (çok sunucu).",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "EventBus": {
      "type": "parameter",
      "displayName": "Altyapı: Event bus + outbox",
      "description": "Outbox/inbox tabloları; süreç içi taşıyıcı, ayarla RabbitMQ.",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "Hangfire": {
      "type": "parameter",
      "displayName": "Altyapı: Hangfire",
      "description": "Kalıcı iş kuyruğu, cron ve /hangfire paneli (kapalıysa bellek içi iş zamanlayıcı).",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "FileStorage": {
      "type": "parameter",
      "displayName": "Altyapı: Dosya depolama",
      "description": "Yerel disk / S3 / Azure Blob.",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "Search": {
      "type": "parameter",
      "displayName": "Altyapı: Arama",
      "description": "Bellek içi arama ya da Elasticsearch.",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "Realtime": {
      "type": "parameter",
      "displayName": "Altyapı: Anlık bildirim (SignalR)",
      "description": "Kullanıcıya/gruba anlık bildirim; Redis varsa backplane.",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "Sms": {
      "type": "parameter",
      "displayName": "Altyapı: SMS",
      "description": "SMS gönderimi (geliştirmede klasöre yazar).",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "AuditTrail": {
      "type": "parameter",
      "displayName": "Modül: Değişiklik geçmişi (audit)",
      "description": "[Audited] entity'lerin değişikliklerini tabloya yazar.",
      "datatype": "bool",
      "defaultValue": "true"
    },
    "Settings": {
      "type": "parameter",
      "displayName": "Modül: Ayarlar",
      "description": "Veritabanında saklanan, yönetim uçlarından değiştirilen uygulama ayarları.",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "Reporting": {
      "type": "parameter",
      "displayName": "Modül: Raporlama",
      "description": "Rapor kaynakları, kayıtlı raporlar, CSV/Excel/PDF dışa aktarma.",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "OpenTelemetry": {
      "type": "parameter",
      "displayName": "Modül: OpenTelemetry",
      "description": "İz ve metrikleri OTLP ile dışa aktarır (Aspire dashboard).",
      "datatype": "bool",
      "defaultValue": "false"
    },
    "CanCoreVersion": {
      "type": "parameter",
      "displayName": "Can.Core sürümü",
      "description": "Kullanılacak Can.Core paket sürümü.",
      "datatype": "text",
      "defaultValue": "0.1.0-local",
      "replaces": "CANCORE_VERSION"
    },
    "CanCoreFeed": {
      "type": "parameter",
      "displayName": "Can.Core paket kaynağı",
      "description": "Can.Core paketlerinin bulunduğu klasör ya da NuGet adresi (boşsa nuget.config'te TODO bırakılır).",
      "datatype": "text",
      "defaultValue": "",
      "replaces": "CANCORE_FEED"
    },
    "HasCanCoreFeed": {
      "type": "computed",
      "value": "(CanCoreFeed != \"\")"
    },
    "UserSecretsId": {
      "type": "generated",
      "generator": "guid",
      "replaces": "USER_SECRETS_ID",
      "parameters": {
        "defaultFormat": "d"
      }
    }
  },
  "sources": [
    {
      "exclude": [
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        ".template.config/**",
        "**/*.user",
        "**/.idea/**",
        "**/.vs/**"
      ],
      "modifiers": [
        {
          "condition": "(!MultiTenancy)",
          "exclude": [
            "src/CanAppTemplate.Persistence/Services/**",
            "src/CanAppTemplate.Application/Common/Abstractions.cs"
          ]
        },
        {
          "condition": "(!ExternalLogin)",
          "exclude": [
            "src/CanAppTemplate.WebApi/Endpoints/ExternalLoginEndpoints.cs"
          ]
        },
        {
          "condition": "(!Settings)",
          "exclude": [
            "src/CanAppTemplate.Application/Common/AppSettings.cs"
          ]
        }
      ]
    }
  ],
  "primaryOutputs": [
    {
      "path": "CanAppTemplate.slnx"
    }
  ]
}
