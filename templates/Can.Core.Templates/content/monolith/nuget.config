<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
<!--#if (HasCanCoreFeed)-->
    <!-- Can.Core paketleri -->
    <add key="can-core" value="CANCORE_FEED" />
<!--#else-->
    <!-- TODO(can-gen): Can.Core paketlerinin kaynağını ekle (yerel klasör ya da özel NuGet sunucusu), ör.:
         <add key="can-core" value="/Users/me/Projects/CAN/Core/artifacts/packages" /> -->
<!--#endif-->
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
<!--#if (HasCanCoreFeed)-->
    <packageSource key="can-core">
      <package pattern="Can.Core.*" />
    </packageSource>
<!--#endif-->
  </packageSourceMapping>
</configuration>
