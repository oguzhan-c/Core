<Project>
  <!-- Bu çözüm CanFx.Templates TEMPLATE_PACKAGE_VERSION ile oluşturuldu. -->
  <PropertyGroup>
    <!-- CanFx paketlerinin sürümü: tek yerden güncellenir. -->
    <CanFxVersion>CANFX_VERSION</CanFxVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- CanFx -->
    <PackageVersion Include="CanFx.Domain" Version="$(CanFxVersion)" />
    <PackageVersion Include="CanFx.Security" Version="$(CanFxVersion)" />
    <PackageVersion Include="CanFx.Security.EntityFrameworkCore" Version="$(CanFxVersion)" />
    <PackageVersion Include="CanFx.Application" Version="$(CanFxVersion)" />
    <PackageVersion Include="CanFx.Mapping" Version="$(CanFxVersion)" />
    <PackageVersion Include="CanFx.Persistence" Version="$(CanFxVersion)" />
    <PackageVersion Include="CanFx.Persistence.Abstractions" Version="$(CanFxVersion)" />
    <PackageVersion Include="CanFx.MultiTenancy" Version="$(CanFxVersion)" />
    <PackageVersion Include="CanFx.BackgroundJobs" Version="$(CanFxVersion)" />
    <PackageVersion Include="CanFx.Mailing" Version="$(CanFxVersion)" />
    <PackageVersion Include="CanFx.Mailing.MailKit" Version="$(CanFxVersion)" />
    <PackageVersion Include="CanFx.Mailing.SendGrid" Version="$(CanFxVersion)" />
    <PackageVersion Include="CanFx.WebApi" Version="$(CanFxVersion)" />
    <PackageVersion Include="CanFx.WebApi.OpenApi" Version="$(CanFxVersion)" />
    <PackageVersion Include="CanFx.Localization" Version="$(CanFxVersion)" />
    <PackageVersion Include="CanFx.Logging.Serilog" Version="$(CanFxVersion)" />
<!--#if (EventBus)-->
    <PackageVersion Include="CanFx.EventBus" Version="$(CanFxVersion)" />
    <PackageVersion Include="CanFx.EventBus.RabbitMQ" Version="$(CanFxVersion)" />
<!--#endif-->
<!--#if (Sms)-->
    <PackageVersion Include="CanFx.Sms" Version="$(CanFxVersion)" />
<!--#endif-->
<!--#if (Realtime)-->
    <PackageVersion Include="CanFx.Realtime" Version="$(CanFxVersion)" />
    <PackageVersion Include="CanFx.Realtime.SignalR" Version="$(CanFxVersion)" />
<!--#endif-->
<!--#if (Search)-->
    <PackageVersion Include="CanFx.Search" Version="$(CanFxVersion)" />
    <PackageVersion Include="CanFx.Search.Elasticsearch" Version="$(CanFxVersion)" />
<!--#endif-->
<!--#if (FileStorage)-->
    <PackageVersion Include="CanFx.FileStorage" Version="$(CanFxVersion)" />
    <PackageVersion Include="CanFx.FileStorage.S3" Version="$(CanFxVersion)" />
    <PackageVersion Include="CanFx.FileStorage.AzureBlob" Version="$(CanFxVersion)" />
<!--#endif-->
<!--#if (Settings)-->
    <PackageVersion Include="CanFx.Settings" Version="$(CanFxVersion)" />
    <PackageVersion Include="CanFx.Settings.AspNetCore" Version="$(CanFxVersion)" />
    <PackageVersion Include="CanFx.Settings.EntityFrameworkCore" Version="$(CanFxVersion)" />
<!--#endif-->
<!--#if (Reporting)-->
    <PackageVersion Include="CanFx.Reporting" Version="$(CanFxVersion)" />
    <PackageVersion Include="CanFx.Reporting.AspNetCore" Version="$(CanFxVersion)" />
    <PackageVersion Include="CanFx.Reporting.EntityFrameworkCore" Version="$(CanFxVersion)" />
<!--#endif-->
<!--#if (Redis)-->
    <PackageVersion Include="CanFx.Caching.Redis" Version="$(CanFxVersion)" />
    <PackageVersion Include="CanFx.Redis.ScaleOut" Version="$(CanFxVersion)" />
<!--#endif-->
<!--#if (Hangfire)-->
    <PackageVersion Include="CanFx.BackgroundJobs.Hangfire" Version="$(CanFxVersion)" />
<!--#endif-->
<!--#if (OpenTelemetry)-->
    <PackageVersion Include="CanFx.Observability.OpenTelemetry" Version="$(CanFxVersion)" />
<!--#endif-->

    <!-- Veritabanı -->
    <!--
      TODO(can-gen): Veritabanı sağlayıcısının sürümünü buraya ekle (Persistence projesine de PackageReference ekle):
        PostgreSQL : Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3
        SQL Server : Microsoft.EntityFrameworkCore.SqlServer 10.0.13 (+ System.Security.Cryptography.Pkcs 10.0.13, güvenlik yaması)
        SQLite     : Microsoft.EntityFrameworkCore.Sqlite 10.0.13
      Örnek: <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
<!--#if (Hangfire)-->
    <!-- Hangfire deposu: başlangıçta bellek içi. Kalıcı depo için Hangfire.PostgreSql 1.21.1 ya da Hangfire.SqlServer 1.8.25 ekle. -->
    <PackageVersion Include="Hangfire.InMemory" Version="1.0.0" />
<!--#endif-->
  </ItemGroup>
</Project>
