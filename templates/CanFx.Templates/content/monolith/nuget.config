<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
<!--#if (HasCanFxFeed)-->
    <!-- CanFx paketleri -->
    <add key="canfx" value="CANFX_FEED" />
<!--#else-->
    <!-- CanFx paketleri nuget.org'dan gelir. Yerel ya da özel bir kaynak kullanacaksan (ör. yayınlanmamış sürüm):
         <add key="canfx" value="/yol/CanFx/artifacts/packages" />  ve aşağıya CanFx.* eşlemesini ekle. -->
<!--#endif-->
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
<!--#if (HasCanFxFeed)-->
    <packageSource key="canfx">
      <package pattern="CanFx.*" />
    </packageSource>
<!--#endif-->
  </packageSourceMapping>
</configuration>
