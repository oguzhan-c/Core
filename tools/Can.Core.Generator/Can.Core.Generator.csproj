<Project Sdk="Microsoft.NET.Sdk">

  <!--
    can-gen'in motoru: çözümü bulur, entity'yi Roslyn ile okur, CRUD dosyalarını üretir ve işaretli yerlere
    (// can-gen:...) ekleme yapar. CLI (can-gen) ve IDE eklentileri (Rider, Visual Studio) bunu kullanır.
  -->
  <PropertyGroup>
    <Description>Can.Core çözümleri için kod üretici (entity → CQRS komut/sorgu, DTO, kurallar, yetkiler, EF yapılandırması, uç noktalar).</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Entity dosyasını sözdizimi ağacıyla okumak için (yalnızca ayrıştırma; derleme yapılmaz). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Can.Core.Generator.Tests" />
  </ItemGroup>

</Project>
