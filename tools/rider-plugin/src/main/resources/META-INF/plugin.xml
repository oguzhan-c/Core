<idea-plugin>
  <id>com.can.core.cangen</id>
  <name>Can.Core Generator (can-gen)</name>
  <vendor>Can</vendor>
  <description><![CDATA[
    Can.Core şablonuyla oluşturulmuş çözümlerde entity'den CRUD (CQRS) kodu üretir:
    Create/Update/Delete komutları, GetById/GetList sorguları, DTO'lar, kurallar, yetkiler, EF yapılandırması ve uç noktalar.
    Kod üretimini <b>can-gen</b> komut satırı aracı yapar; eklenti onu çağırır ve üretilen dosyaları açar.
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.rider</depends>

  <extensions defaultExtensionNs="com.intellij">
    <applicationService serviceImplementation="com.can.core.cangen.CanGenSettings"/>
    <applicationConfigurable parentId="tools" instance="com.can.core.cangen.CanGenConfigurable"
                             id="com.can.core.cangen.settings" displayName="Can.Core Generator"/>
    <notificationGroup id="can-gen" displayType="BALLOON"/>
  </extensions>

  <actions>
    <group id="CanGen.Group" text="Can.Core" popup="true" icon="AllIcons.Actions.Lightning">
      <action id="CanGen.GenerateCrud" class="com.can.core.cangen.GenerateCrudAction"
              text="Generate CRUD..." description="Seçili entity için CRUD kodunu üretir (can-gen crud)"/>
      <action id="CanGen.ChooseEntity" class="com.can.core.cangen.ChooseEntityAction"
              text="Generate CRUD for Entity..." description="Domain'deki entity'lerden birini seçip CRUD üretir"/>
      <add-to-group group-id="SolutionExplorerPopupMenu" anchor="last"/>
      <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </group>
  </actions>
</idea-plugin>
