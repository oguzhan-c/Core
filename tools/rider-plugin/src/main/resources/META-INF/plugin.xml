<idea-plugin>
  <id>com.canfx.cangen</id>
  <name>CanFx Generator (can-gen)</name>
  <vendor>Oğuzhan Can</vendor>
  <description><![CDATA[
    CanFx şablonuyla oluşturulmuş çözümlerde entity'den CRUD (CQRS) kodu üretir:
    Create/Update/Delete komutları, GetById/GetList sorguları, DTO'lar, kurallar, yetkiler, EF yapılandırması ve uç noktalar.
    Kod üretimini <b>can-gen</b> komut satırı aracı yapar; eklenti onu çağırır ve üretilen dosyaları açar.
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.rider</depends>

  <extensions defaultExtensionNs="com.intellij">
    <applicationService serviceImplementation="com.canfx.cangen.CanGenSettings"/>
    <applicationConfigurable parentId="tools" instance="com.canfx.cangen.CanGenConfigurable"
                             id="com.canfx.cangen.settings" displayName="CanFx Generator"/>
    <notificationGroup id="can-gen" displayType="BALLOON"/>
  </extensions>

  <actions>
    <action id="CanGen.GenerateCrud" class="com.canfx.cangen.GenerateCrudAction"
            text="CanFx: Generate CRUD..." description="Seçili entity için CRUD kodunu üretir (can-gen crud)"
            icon="AllIcons.Actions.Lightning">
      <add-to-group group-id="SolutionExplorerPopupMenu" anchor="last"/>
      <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
